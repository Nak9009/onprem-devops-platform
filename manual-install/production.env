#!/usr/bin/env bash
# ==============================================================================
# manual-install/production.env
# Global Environment File for PRODUCTION VMWARE vSPHERE Manual Installation
# Usage: ./manual-install/devops-cli.sh --env production <command>
# ==============================================================================

export PLATFORM_ENV="production"
export DOMAIN="${DOMAIN:-internal.example.com}"
export TIMEZONE="${TIMEZONE:-Asia/Phnom_Penh}"
export SSH_USER="${SSH_USER:-ansible}"

# --- Layer 1A: DevOps Services (VLAN 20: 10.20.20.0/24) ---
export GITLAB_IP="${GITLAB_IP:-10.20.20.10}"
export JENKINS_IP="${JENKINS_IP:-10.20.20.11}"
export JENKINS_AGENT01_IP="${JENKINS_AGENT01_IP:-10.20.20.12}"
export JENKINS_AGENT02_IP="${JENKINS_AGENT02_IP:-10.20.20.13}"
export NEXUS_IP="${NEXUS_IP:-10.20.20.14}"

# --- Layer 1B: PostgreSQL 16 HA (5 VMs: 2x LB + 3x DB in VLAN 50) & Redis ---
export PG_VIP="${PG_VIP:-10.20.50.10}"
export PG_RO_VIP="${PG_RO_VIP:-10.20.50.15}"
export PG_LB1_IP="${PG_LB1_IP:-10.20.50.8}"
export PG_LB2_IP="${PG_LB2_IP:-10.20.50.9}"
export PG_DB1_IP="${PG_DB1_IP:-10.20.50.11}"
export PG_DB2_IP="${PG_DB2_IP:-10.20.50.12}"
export PG_DB3_IP="${PG_DB3_IP:-10.20.50.13}"
export REDIS_IP="${REDIS_IP:-10.20.50.21}"
export REDIS02_IP="${REDIS02_IP:-10.20.50.22}"
export REDIS03_IP="${REDIS03_IP:-10.20.50.23}"

# --- Layer 1C: 4-Node Distributed MinIO S3 Storage (VLAN 60: 10.20.60.0/24) ---
export MINIO_VIP="${MINIO_VIP:-10.20.60.10}"
export MINIO01_IP="${MINIO01_IP:-10.20.60.11}"
export MINIO02_IP="${MINIO02_IP:-10.20.60.12}"
export MINIO03_IP="${MINIO03_IP:-10.20.60.13}"
export MINIO04_IP="${MINIO04_IP:-10.20.60.14}"

# --- Layer 1D: Monitoring (VLAN 70), Backup (VLAN 80) & Vault (VLAN 10) ---
export MONITOR_IP="${MONITOR_IP:-10.20.70.10}"
export LOKI_SERVER_IP="${LOKI_SERVER_IP:-${MONITOR_IP}}"
export BACKUP_IP="${BACKUP_IP:-10.20.80.10}"
export VAULT_IP="${VAULT_IP:-10.20.10.16}"

# --- Layer 2: Dedicated 3-Node Management Kubernetes Cluster (VLAN 30) ---
export K8S_MGMT_VIP="${K8S_MGMT_VIP:-10.20.30.10}"
export K8S_MGMT_CP01_IP="${K8S_MGMT_CP01_IP:-10.20.30.11}"
export K8S_MGMT_CP02_IP="${K8S_MGMT_CP02_IP:-10.20.30.12}"
export K8S_MGMT_CP03_IP="${K8S_MGMT_CP03_IP:-10.20.30.13}"
export MGMT_POD_CIDR="10.243.0.0/16"
export MGMT_SVC_CIDR="10.95.0.0/12"

# --- Layer 3: 6-Node HA Application Kubernetes Cluster (VLAN 40) ---
export K8S_APP_VIP="${K8S_APP_VIP:-10.20.40.10}"
export K8S_APP_INGRESS_VIP="${K8S_APP_INGRESS_VIP:-10.20.40.20}"
export K8S_APP_CP01_IP="${K8S_APP_CP01_IP:-10.20.40.11}"
export K8S_APP_CP02_IP="${K8S_APP_CP02_IP:-10.20.40.12}"
export K8S_APP_CP03_IP="${K8S_APP_CP03_IP:-10.20.40.13}"
export K8S_APP_WORKER01_IP="${K8S_APP_WORKER01_IP:-10.20.40.21}"
export K8S_APP_WORKER02_IP="${K8S_APP_WORKER02_IP:-10.20.40.22}"
export K8S_APP_WORKER03_IP="${K8S_APP_WORKER03_IP:-10.20.40.23}"
export APP_POD_CIDR="10.244.0.0/16"
export APP_SVC_CIDR="10.96.0.0/12"

# --- Production Resource Settings & Pinned Software Versions ---
export JVM_HEAP="4096m"
export REDIS_MAXMEM="4096mb"
export NODE_EXP_VER="1.8.2"
export GITLAB_VER="17.7.1-ce.0"
export GLAB_VER="1.51.0"
export JENKINS_VER="2.479.3"
export TRIVY_VER="0.58.1"
export KUBECTL_VER="v1.31.4"
export HELM_VER="v3.16.4"
export NEXUS_VER="3.75.1-01"
export MINIO_VER="RELEASE.2024-12-18T13-15-44Z"
export PG_VER="16"
export RANCHER_VER="v2.10.1"
export RANCHER_CLI_VER="v2.15.3"
export K8S_VER="1.31.4"
export K8S_PKG_VER="1.31.4-1.1"
export CALICO_VER="v3.29.1"
export ARGOCD_VER="v2.13.2"
export PROM_VER="2.53.3"
export GRAFANA_VER="11.4.0"
export LOKI_VER="3.3.2"
export VAULT_VER="1.18.3"

# --- Production Service URLs & Initial Credentials (Override before running) ---
export GITLAB_URL="http://gitlab.${DOMAIN}"
export GITLAB_ROOT_PASS="${GITLAB_ROOT_PASS:-ChangeMe_GitLabRootPass_2026!}"
export MINIO_ROOT_USER="${MINIO_ROOT_USER:-minioadmin}"
export MINIO_ROOT_PASS="${MINIO_ROOT_PASS:-ChangeMe_MinioSecretKey_2026!}"
export RANCHER_BOOTSTRAP_PASS="${RANCHER_BOOTSTRAP_PASS:-ChangeMe_RancherBootstrap_2026!}"
export GRAFANA_PASS="${GRAFANA_PASS:-ChangeMe_GrafanaAdmin_2026!}"
export REDIS_PASS="${REDIS_PASS:-ChangeMe_RedisSecret_2026!}"
export PG_ADMIN_PASS="${PG_ADMIN_PASS:-ChangeMe_PostgresAdmin_2026!}"
export PG_REPL_PASS="${PG_REPL_PASS:-ChangeMe_ReplPass_2026!}"

