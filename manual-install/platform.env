#!/usr/bin/env bash
# ==============================================================================
# manual-install/platform.env
# Global Environment Configuration & Pinned Versions for Manual Installations
# Sourced automatically by manual-install/devops-cli.sh and all */install.sh
# ==============================================================================

# --- 1. Environment & Domain ---
export PLATFORM_ENV="${PLATFORM_ENV:-production}"
export DOMAIN="${DOMAIN:-internal.example.com}"
export TIMEZONE="${TIMEZONE:-Asia/Phnom_Penh}"
export SSH_USER="${SSH_USER:-ansible}"

# --- 2. Layer 1: DevOps, Database HA, Storage, Monitoring & Backup IPs ---
# VLAN 20: DevOps Services
export GITLAB_IP="${GITLAB_IP:-10.20.20.10}"
export JENKINS_IP="${JENKINS_IP:-10.20.20.11}"
export JENKINS_AGENT01_IP="${JENKINS_AGENT01_IP:-10.20.20.12}"
export JENKINS_AGENT02_IP="${JENKINS_AGENT02_IP:-10.20.20.13}"
export NEXUS_IP="${NEXUS_IP:-10.20.20.14}"

# VLAN 50: PostgreSQL 16 HA (5 VMs: 2x HA LB + 3x HA DB) & Redis
export PG_VIP="${PG_VIP:-10.20.50.10}"
export PG_RO_VIP="${PG_RO_VIP:-10.20.50.15}"
export PG_LB1_IP="${PG_LB1_IP:-10.20.50.8}"
export PG_LB2_IP="${PG_LB2_IP:-10.20.50.9}"
export PG_DB1_IP="${PG_DB1_IP:-10.20.50.11}"
export PG_DB2_IP="${PG_DB2_IP:-10.20.50.12}"
export PG_DB3_IP="${PG_DB3_IP:-10.20.50.13}"
export REDIS_IP="${REDIS_IP:-10.20.50.21}"

# VLAN 60: Distributed MinIO S3 Storage
export MINIO_VIP="${MINIO_VIP:-10.20.60.10}"
export MINIO01_IP="${MINIO01_IP:-10.20.60.11}"
export MINIO02_IP="${MINIO02_IP:-10.20.60.12}"
export MINIO03_IP="${MINIO03_IP:-10.20.60.13}"
export MINIO04_IP="${MINIO04_IP:-10.20.60.14}"

# VLAN 70, 80, 10: Monitoring, Backup & Vault
export MONITOR_IP="${MONITOR_IP:-10.20.70.10}"
export LOKI_SERVER_IP="${LOKI_SERVER_IP:-${MONITOR_IP}}"
export BACKUP_IP="${BACKUP_IP:-10.20.80.10}"
export VAULT_IP="${VAULT_IP:-10.20.10.16}"

# --- 3. Layer 2: Dedicated Kubernetes Management Cluster (VLAN 30) ---
export K8S_MGMT_VIP="${K8S_MGMT_VIP:-10.20.30.10}"
export K8S_MGMT_CP01_IP="${K8S_MGMT_CP01_IP:-10.20.30.11}"
export K8S_MGMT_CP02_IP="${K8S_MGMT_CP02_IP:-10.20.30.12}"
export K8S_MGMT_CP03_IP="${K8S_MGMT_CP03_IP:-10.20.30.13}"
export MGMT_POD_CIDR="${MGMT_POD_CIDR:-10.243.0.0/16}"
export MGMT_SVC_CIDR="${MGMT_SVC_CIDR:-10.95.0.0/12}"

# --- 4. Layer 3: Application Kubernetes Cluster (VLAN 40 — Business Apps Only) ---
export K8S_APP_VIP="${K8S_APP_VIP:-10.20.40.10}"
export K8S_APP_INGRESS_VIP="${K8S_APP_INGRESS_VIP:-10.20.40.20}"
export K8S_APP_CP01_IP="${K8S_APP_CP01_IP:-10.20.40.11}"
export K8S_APP_CP02_IP="${K8S_APP_CP02_IP:-10.20.40.12}"
export K8S_APP_CP03_IP="${K8S_APP_CP03_IP:-10.20.40.13}"
export K8S_APP_WORKER01_IP="${K8S_APP_WORKER01_IP:-10.20.40.21}"
export K8S_APP_WORKER02_IP="${K8S_APP_WORKER02_IP:-10.20.40.22}"
export K8S_APP_WORKER03_IP="${K8S_APP_WORKER03_IP:-10.20.40.23}"
export APP_POD_CIDR="${APP_POD_CIDR:-10.244.0.0/16}"
export APP_SVC_CIDR="${APP_SVC_CIDR:-10.96.0.0/12}"

# --- 5. Pinned Software & CLI Versions (Ubuntu 24.04 LTS Verified) ---
export NODE_EXP_VER="${NODE_EXP_VER:-1.8.2}"
export GITLAB_VER="${GITLAB_VER:-17.7.1-ce.0}"
export GLAB_VER="${GLAB_VER:-1.51.0}"
export JENKINS_VER="${JENKINS_VER:-2.479.3}"
export TRIVY_VER="${TRIVY_VER:-0.58.1}"
export KUBECTL_VER="${KUBECTL_VER:-v1.31.4}"
export HELM_VER="${HELM_VER:-v3.16.4}"
export NEXUS_VER="${NEXUS_VER:-3.75.1-01}"
export JVM_HEAP="${JVM_HEAP:-1200m}"
export MINIO_VER="${MINIO_VER:-RELEASE.2024-12-18T13-15-44Z}"
export PG_VER="${PG_VER:-16}"
export REDIS_MAXMEM="${REDIS_MAXMEM:-512mb}"
export RANCHER_VER="${RANCHER_VER:-v2.10.1}"
export RANCHER_CLI_VER="${RANCHER_CLI_VER:-v2.15.3}"
export K8S_VER="${K8S_VER:-1.31.4}"
export K8S_PKG_VER="${K8S_PKG_VER:-1.31.4-1.1}"
export CALICO_VER="${CALICO_VER:-v3.29.1}"
export ARGOCD_VER="${ARGOCD_VER:-v2.13.2}"
