export GRAFANA_VER="${GRAFANA_VER:-11.4.0}"
export LOKI_VER="${LOKI_VER:-3.3.2}"
export VAULT_VER="${VAULT_VER:-1.18.3}"

# --- 6. Service URLs & Initial Bootstrap Credentials ---
export GITLAB_URL="${GITLAB_URL:-http://gitlab.${DOMAIN}}"
export GITLAB_ROOT_PASS="${GITLAB_ROOT_PASS:-ChangeMe_GitLabRootPass_2026!}"
export MINIO_ROOT_USER="${MINIO_ROOT_USER:-minioadmin}"
export MINIO_ROOT_PASS="${MINIO_ROOT_PASS:-ChangeMe_MinioSecretKey_2026!}"
export RANCHER_BOOTSTRAP_PASS="${RANCHER_BOOTSTRAP_PASS:-ChangeMe_RancherBootstrap_2026!}"
export GRAFANA_PASS="${GRAFANA_PASS:-ChangeMe_GrafanaAdmin_2026!}"
export REDIS_PASS="${REDIS_PASS:-ChangeMe_RedisSecret_2026!}"
export PG_ADMIN_PASS="${PG_ADMIN_PASS:-ChangeMe_PostgresAdmin_2026!}"
export PG_REPL_PASS="${PG_REPL_PASS:-ChangeMe_ReplPass_2026!}"

