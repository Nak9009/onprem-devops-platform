#!/usr/bin/env bash
# ==============================================================================
# manual-install/local.env
# Global Environment File for LOCAL MULTIPASS Manual Installation
# Usage: ./manual-install/devops-cli.sh --env local <command>
# ==============================================================================

export PLATFORM_ENV="local"
export DOMAIN="${DOMAIN:-devops.local}"
export TIMEZONE="${TIMEZONE:-Asia/Phnom_Penh}"
export SSH_USER="${SSH_USER:-ubuntu}"

# --- Layer 1: Local Multipass VMs (192.168.252.0/24 Bridge Subnet) ---
export GITLAB_IP="${GITLAB_IP:-192.168.252.10}"
export JENKINS_IP="${JENKINS_IP:-192.168.252.11}"
export JENKINS_AGENT01_IP="${JENKINS_AGENT01_IP:-192.168.252.11}"
export NEXUS_IP="${NEXUS_IP:-192.168.252.12}"
export MINIO_VIP="${MINIO_VIP:-192.168.252.12}"

# PostgreSQL HA / Single Local DB + Redis
export PG_VIP="${PG_VIP:-192.168.252.15}"
export PG_RO_VIP="${PG_RO_VIP:-192.168.252.15}"
export PG_LB1_IP="${PG_LB1_IP:-192.168.252.15}"
export PG_LB2_IP="${PG_LB2_IP:-192.168.252.16}"
export PG_DB1_IP="${PG_DB1_IP:-192.168.252.17}"
export PG_DB2_IP="${PG_DB2_IP:-192.168.252.18}"
export PG_DB3_IP="${PG_DB3_IP:-192.168.252.19}"
export REDIS_IP="${REDIS_IP:-192.168.252.17}"

# Monitoring, Logging, Backup & Vault (co-located on devops-monitor locally)
export MONITOR_IP="${MONITOR_IP:-192.168.252.25}"
export LOKI_SERVER_IP="${LOKI_SERVER_IP:-${MONITOR_IP}}"
export BACKUP_IP="${BACKUP_IP:-${MONITOR_IP}}"
export VAULT_IP="${VAULT_IP:-${MONITOR_IP}}"

# --- Layer 2: Local Management Kubernetes Cluster (Rancher + Argo CD) ---
export K8S_MGMT_VIP="${K8S_MGMT_VIP:-192.168.252.23}"
export K8S_MGMT_CP01_IP="${K8S_MGMT_CP01_IP:-192.168.252.23}"
export MGMT_POD_CIDR="10.243.0.0/16"
export MGMT_SVC_CIDR="10.95.0.0/12"

# --- Layer 3: Local Application Kubernetes Cluster (Business Apps Only) ---
export K8S_APP_VIP="${K8S_APP_VIP:-192.168.252.24}"
export K8S_APP_CP01_IP="${K8S_APP_CP01_IP:-192.168.252.24}"
export K8S_APP_WORKER01_IP="${K8S_APP_WORKER01_IP:-192.168.252.31}"
export APP_POD_CIDR="10.244.0.0/16"
export APP_SVC_CIDR="10.96.0.0/12"

# --- Local Resource-Tuned Settings & Pinned Versions ---
export JVM_HEAP="1200m"
export REDIS_MAXMEM="256mb"
export NODE_EXP_VER="1.8.2"
export GITLAB_VER="17.7.1-ce.0"
export GLAB_VER="1.51.0"
export JENKINS_VER="2.479.3"
export TRIVY_VER="0.58.1"
export KUBECTL_VER="v1.31.4"
export HELM_VER="v3.16.4"
export NEXUS_VER="3.75.1-01"
export MINIO_VER="RELEASE.2024-12-18T13-15-44Z"
export PG_VER="16"
export RANCHER_VER="v2.10.1"
export RANCHER_CLI_VER="v2.9.0"
export K8S_VER="1.31.4"
export K8S_PKG_VER="1.31.4-1.1"
export CALICO_VER="v3.29.1"
export ARGOCD_VER="v2.13.2"
export PROM_VER="2.53.3"
export GRAFANA_VER="11.4.0"
export LOKI_VER="3.3.2"
export VAULT_VER="1.18.3"

# --- Local Service URLs & Bootstrap Credentials ---
export GITLAB_URL="http://${GITLAB_IP}"
export GITLAB_ROOT_PASS="${GITLAB_ROOT_PASS:-DevOps_Local_GitLab_2026!}"
export MINIO_ROOT_USER="${MINIO_ROOT_USER:-minioadmin}"
export MINIO_ROOT_PASS="${MINIO_ROOT_PASS:-DevOps_Local_MinIO_2026!}"
export RANCHER_BOOTSTRAP_PASS="${RANCHER_BOOTSTRAP_PASS:-DevOps_Local_Rancher_2026!}"
export GRAFANA_PASS="${GRAFANA_PASS:-DevOps_Local_Grafana_2026!}"
export REDIS_PASS="${REDIS_PASS:-DevOps_Local_Redis_2026!}"
export PG_ADMIN_PASS="${PG_ADMIN_PASS:-DevOps_Local_Postgres_2026!}"
export PG_REPL_PASS="${PG_REPL_PASS:-DevOps_Local_Repl_2026!}"

