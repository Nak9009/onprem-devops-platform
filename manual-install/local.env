#!/usr/bin/env bash
# ==============================================================================
# manual-install/local.env
# Global Environment File for LOCAL MULTIPASS Manual Installation
# Automatically detects live Multipass VM IPs when multipass CLI is present,
# and falls back to the last synced Multipass IPs when copied inside a VM.
# ==============================================================================

export PLATFORM_ENV="local"
export DOMAIN="${DOMAIN:-devops.local}"
export TIMEZONE="${TIMEZONE:-Asia/Phnom_Penh}"
export SSH_USER="${SSH_USER:-ansible}"

_mp_ip() {
  local vm="$1"
  local fallback="$2"
  if command -v multipass >/dev/null 2>&1; then
    local ip
    ip="$(multipass list --format csv 2>/dev/null | awk -F',' -v v="$vm" '$1==v && $2=="Running" {print $3}' | awk '{print $1}')"
    if [[ -n "${ip}" ]]; then
      echo "${ip}"
      return 0
    fi
  fi
  echo "${fallback}"
}

# --- Layer 1: Local Multipass VMs (Auto-synced with Multipass DHCP) ---
export GITLAB_IP="${GITLAB_IP:-$(_mp_ip devops-gitlab 192.168.252.10)}"
export JENKINS_IP="${JENKINS_IP:-$(_mp_ip devops-jenkins 192.168.252.11)}"
export JENKINS_AGENT01_IP="${JENKINS_AGENT01_IP:-${JENKINS_IP}}"
export NEXUS_IP="${NEXUS_IP:-$(_mp_ip devops-nexus 192.168.252.12)}"
export MINIO_VIP="${MINIO_VIP:-${NEXUS_IP}}"

# PostgreSQL HA / Local DB + Redis (pg-db1: 192.168.252.26)
export PG_DB1_IP="${PG_DB1_IP:-$(_mp_ip pg-db1 192.168.252.26)}"
export PG_DB2_IP="${PG_DB2_IP:-$(_mp_ip pg-db2 192.168.252.18)}"
export PG_DB3_IP="${PG_DB3_IP:-$(_mp_ip pg-db3 192.168.252.19)}"
export PG_LB1_IP="${PG_LB1_IP:-$(_mp_ip pg-lb1 "${PG_DB1_IP}")}"
export PG_LB2_IP="${PG_LB2_IP:-$(_mp_ip pg-lb2 "${PG_DB2_IP}")}"
export PG_VIP="${PG_VIP:-${PG_LB1_IP}}"
export PG_RO_VIP="${PG_RO_VIP:-${PG_LB1_IP}}"
export REDIS_IP="${REDIS_IP:-$(_mp_ip devops-redis01 "${PG_DB1_IP}")}"

# Monitoring, Logging, Backup & Vault (devops-monitor: 192.168.252.29)
export MONITOR_IP="${MONITOR_IP:-$(_mp_ip devops-monitor 192.168.252.29)}"
export LOKI_SERVER_IP="${LOKI_SERVER_IP:-${MONITOR_IP}}"
export BACKUP_IP="${BACKUP_IP:-${MONITOR_IP}}"
export VAULT_IP="${VAULT_IP:-${MONITOR_IP}}"

# --- Layer 2: Local Management Kubernetes Cluster (k8s-mgmt-cp01: 192.168.252.27) ---
export K8S_MGMT_CP01_IP="${K8S_MGMT_CP01_IP:-$(_mp_ip k8s-mgmt-cp01 192.168.252.27)}"
export K8S_MGMT_VIP="${K8S_MGMT_VIP:-${K8S_MGMT_CP01_IP}}"
export MGMT_POD_CIDR="10.243.0.0/16"
export MGMT_SVC_CIDR="10.95.0.0/12"

# --- Layer 3: Local Application Kubernetes Cluster (k8s-cp01: 192.168.252.28) ---
export K8S_APP_CP01_IP="${K8S_APP_CP01_IP:-$(_mp_ip k8s-cp01 192.168.252.28)}"
export K8S_APP_VIP="${K8S_APP_VIP:-${K8S_APP_CP01_IP}}"
export K8S_APP_WORKER01_IP="${K8S_APP_WORKER01_IP:-$(_mp_ip k8s-worker01 "${K8S_APP_CP01_IP}")}"
export APP_POD_CIDR="10.244.0.0/16"
export APP_SVC_CIDR="10.96.0.0/12"

# --- Local Resource-Tuned Settings & Pinned Versions ---
export JVM_HEAP="1200m"
export REDIS_MAXMEM="256mb"
export NODE_EXP_VER="1.8.2"
export GITLAB_VER="17.7.1-ce.0"
export GLAB_VER="1.51.0"
export JENKINS_VER="2.479.3"
export TRIVY_VER="0.58.1"
export KUBECTL_VER="v1.31.4"
export HELM_VER="v3.16.4"
export NEXUS_VER="3.75.1-01"
export MINIO_VER="RELEASE.2024-12-18T13-15-44Z"
export PG_VER="16"
export RANCHER_VER="v2.10.1"
export RANCHER_CLI_VER="v2.15.3"
export K8S_VER="1.31.4"
export K8S_PKG_VER="1.31.4-1.1"
export CALICO_VER="v3.29.1"
export ARGOCD_VER="v2.13.2"
export PROM_VER="2.53.3"
export GRAFANA_VER="11.4.0"
export LOKI_VER="3.3.2"
export VAULT_VER="1.18.3"

# --- Local Service URLs & Bootstrap Credentials ---
export GITLAB_URL="http://${GITLAB_IP}"
export GITLAB_ROOT_PASS="${GITLAB_ROOT_PASS:-DevOps_Local_GitLab_2026!}"
export MINIO_ROOT_USER="${MINIO_ROOT_USER:-minioadmin}"
export MINIO_ROOT_PASS="${MINIO_ROOT_PASS:-DevOps_Local_MinIO_2026!}"
export RANCHER_BOOTSTRAP_PASS="${RANCHER_BOOTSTRAP_PASS:-DevOps_Local_Rancher_2026!}"
export GRAFANA_PASS="${GRAFANA_PASS:-DevOps_Local_Grafana_2026!}"
export REDIS_PASS="${REDIS_PASS:-DevOps_Local_Redis_2026!}"
export PG_ADMIN_PASS="${PG_ADMIN_PASS:-DevOps_Local_Postgres_2026!}"
export PG_REPL_PASS="${PG_REPL_PASS:-DevOps_Local_Repl_2026!}"
