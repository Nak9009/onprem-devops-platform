# docker-lab/.env - Default Lab Credentials and Variables
# Copy to .env if you wish to override values locally.

# Platform Domain & Host Binding
DOMAIN=devops.local
HOST_IP=127.0.0.1

# Container Image Tags (Latest multi-arch native for arm64/Mac & amd64)
GITLAB_IMAGE=gitlab/gitlab-ce:latest
JENKINS_IMAGE=jenkins/jenkins:lts-jdk21
NEXUS_IMAGE=sonatype/nexus3:latest
POSTGRES_IMAGE=postgres:17-alpine
REDIS_IMAGE=redis:alpine
GARAGE_IMAGE=dxflrs/garage:v1.1.0
SONARQUBE_IMAGE=sonarqube:community
PROMETHEUS_IMAGE=prom/prometheus:latest
GRAFANA_IMAGE=grafana/grafana-oss:latest
LOKI_IMAGE=grafana/loki:latest
PROMTAIL_IMAGE=grafana/promtail:latest

# PostgreSQL & Database Settings (Host port 5435 avoids conflicts with local/gvproxy postgres)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ChangeMePostgres123!
POSTGRES_DB=postgres
POSTGRES_HOST_PORT=5435

# Redis Settings (Host port 6381 avoids conflicts with local/gvproxy redis)
REDIS_HOST_PORT=6381

# GitLab Settings (Host port 8082 avoids conflicts with local port 80 webservers)
GITLAB_ROOT_PASSWORD=ChangeMeGitlab123!
GITLAB_HTTP_PORT=8082
GITLAB_SSH_PORT=2222

# Jenkins Settings
JENKINS_HTTP_PORT=8080
JENKINS_AGENT_PORT=50000

# Nexus Repository Settings (Host port 8085 avoids gvproxy 8081; 5002/5003 avoid macOS AirPlay 5000)
NEXUS_HTTP_PORT=8085
NEXUS_DOCKER_HOSTED_PORT=5002
NEXUS_DOCKER_GROUP_PORT=5003

# Garage S3 Object Storage Settings
GARAGE_S3_API_PORT=3900
GARAGE_WEB_PORT=3902
GARAGE_ADMIN_PORT=3903
GARAGE_ADMIN_TOKEN=ChangeMeAdminToken1234567890

# SonarQube Settings
SONAR_HTTP_PORT=9002

# Monitoring & Logging
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100
GRAFANA_ADMIN_PASSWORD=ChangeMeGrafana123!
