# Managed by Ansible - Hardened Redis Configuration (Layer 1 Outside Kubernetes)
bind 0.0.0.0
protected-mode yes
port {{ redis_port | default(6379) }}
tcp-backlog 511
timeout 0
tcp-keepalive 300
daemonize no
supervised systemd
pidfile /run/redis/redis-server.pid
loglevel notice
logfile /var/log/redis/redis-server.log
databases 16
dir /var/lib/redis
requirepass {{ vault_redis_password | default('ChangeMe_RedisSecret_2026!') }}
maxmemory {{ redis_maxmemory | default('512mb') }}
maxmemory-policy {{ redis_maxmemory_policy | default('allkeys-lru') }}
appendonly yes
appendfsync everysec

