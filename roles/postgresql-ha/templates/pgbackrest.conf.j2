# Managed by Ansible - pgBackRest Configuration for PITR & Continuous WAL Archiving
[global]
repo1-path=/var/lib/pgbackrest
repo1-retention-full={{ pgbackrest_retention_full | default(2) }}
repo1-retention-diff={{ pgbackrest_retention_diff | default(7) }}
process-max=2
log-level-console=info
log-level-file=detail
start-fast=y
backup-standby={{ 'y' if (groups['postgresql_ha'] | default([]) | length > 1) else 'n' }}

[{{ pgbackrest_stanza | default('main') }}]
pg1-path=/var/lib/postgresql/16/main
pg1-port=5432

