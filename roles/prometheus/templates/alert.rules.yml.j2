# {{ ansible_managed }}
# /etc/prometheus/rules/alert.rules.yml - Platform Infrastructure & Service Alerts
groups:
  - name: infrastructure_alerts
    rules:
      - alert: InstanceDown
        expr: up == 0
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "Node or target {{ $labels.instance }} is down"
          description: "Target {{ $labels.instance }} in job {{ $labels.job }} has been unreachable for more than 2 minutes."

      - alert: HighCpuLoad
        expr: 100 - (avg by(instance) (rate(node_cpu_seconds_total{mode="idle"}[5m])) * 100) > 85
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "High CPU usage (>85%) on {{ $labels.instance }}"
          description: "CPU utilization has exceeded 85% for 5 minutes on {{ $labels.instance }}."

      - alert: HighMemoryUsage
        expr: (1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100 > 90
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "High memory utilization (>90%) on {{ $labels.instance }}"
          description: "Available memory is below 10% on {{ $labels.instance }}."

      - alert: RootDiskSpaceLow
        expr: (node_filesystem_avail_bytes{mountpoint="/",fstype!="rootfs"} / node_filesystem_size_bytes{mountpoint="/",fstype!="rootfs"}) * 100 < 15
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "Low root filesystem disk space (<15% free) on {{ $labels.instance }}"
          description: "Root filesystem on {{ $labels.instance }} has less than 15% free space remaining."

