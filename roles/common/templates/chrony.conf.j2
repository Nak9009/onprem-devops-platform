# {{ ansible_managed }}
# Chrony NTP configuration
{% for ntp_server in common_ntp_servers %}
pool {{ ntp_server }} iburst maxsources 4
{% endfor %}
keyfile /etc/chrony/chrony.keys
driftfile /var/lib/chrony/chrony.drift
logdir /var/log/chrony
maxupdateskew 100.0
rtcsync
makestep 1 3
leapsectz right/UTC

