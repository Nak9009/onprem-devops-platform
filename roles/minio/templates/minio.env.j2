# {{ ansible_managed }}
# /etc/default/minio - MinIO Environment Configuration
MINIO_VOLUMES="{{ minio_storage_dir }}"
MINIO_OPTS="--address :{{ minio_s3_port }} --console-address :{{ minio_web_port }}"
MINIO_ROOT_USER="{{ minio_root_username }}"
MINIO_ROOT_PASSWORD="{{ minio_root_secret }}"
MINIO_SERVER_URL="http://{{ minio_domain | default('minio.devops.local') }}:{{ minio_s3_port }}"
MINIO_BROWSER_REDIRECT_URL="http://{{ minio_console_domain | default('s3-console.devops.local') }}:{{ minio_web_port }}"

