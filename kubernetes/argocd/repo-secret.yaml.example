---
# kubernetes/argocd/repo-secret.yaml.example
# Scoped Read-Only GitLab Deploy Token Secret for Argo CD Repository Access
# Apply with: kubectl apply -f repo-secret.yaml

apiVersion: v1
kind: Secret
metadata:
  name: gitlab-gitops-repo-creds
  namespace: argocd
  labels:
    argocd.argoproj.io/secret-type: repository
type: Opaque
stringData:
  type: git
  url: https://gitlab.devops.local/devops/gitops.git
  username: argocd-deploy-token
  password: "<REPLACE_WITH_GITLAB_READONLY_DEPLOY_TOKEN>"
  insecure: "true"

